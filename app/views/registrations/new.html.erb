<div class="w-full max-w-lg space-y-4">
  <h1 class="text-2xl font-bold">Create profile</h1>

  <% if @user.errors.any? %>
    <ul role="alert" class="rounded bg-red-50 p-4 text-red-700">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @user, url: registration_path,
    class: "space-y-4" do |form| %>
    <div>
      <%= form.label :full_name, class: "block font-semibold" %>
      <%= form.text_field :full_name, required: true, autocomplete: "name",
        class: "w-full rounded border p-2" %>
    </div>

    <div>
      <%= form.label :email, class: "block font-semibold" %>
      <%= form.email_field :email, required: true, autocomplete: "email",
        class: "w-full rounded border p-2" %>
    </div>

    <div>
      <%= form.label :password, class: "block font-semibold" %>
      <%= form.password_field :password, required: true, minlength: 12,
        autocomplete: "new-password", aria: { describedby: "password-help" },
        class: "w-full rounded border p-2" %>
      <p id="password-help" class="text-sm text-gray-600">
        Use at least 12 characters.
      </p>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block font-semibold" %>
      <%= form.password_field :password_confirmation, required: true,
        minlength: 12, autocomplete: "new-password",
        class: "w-full rounded border p-2" %>
    </div>

    <%= form.submit "Create account",
      class: "rounded bg-indigo-600 px-4 py-2 text-white" %>
    <%= link_to "Sign in", new_session_path, class: "underline" %>
  <% end %>
</div>