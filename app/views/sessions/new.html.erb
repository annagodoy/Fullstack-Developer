<div class="mx-auto max-w-md py-4 sm:py-10">
  <div class="card border border-base-300 bg-base-100">
    <div class="card-body gap-6 p-5 sm:p-8">
      <div>
        <h1 class="text-2xl font-bold">Sign in</h1>
        <p class="mt-2 text-base-content/70">
          Welcome back. Enter your data to login.
        </p>
      </div>

      <% if alert = flash[:alert] %>
        <div id="alert" role="alert" class="alert alert-error">
          <span><%= alert %></span>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div id="notice" role="status" class="alert alert-success">
          <span><%= notice %></span>
        </div>
      <% end %>

      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <div class="space-y-2">
          <%= form.label :email, class: "block text-sm font-medium" %>
          <%= form.email_field :email,
            required: true,
            autocomplete: "username",
            placeholder: "Email",
            value: params[:email],
            class: "input w-full" %>
        </div>

        <div class="space-y-2">
          <%= form.label :password, class: "block text-sm font-medium" %>
          <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            placeholder: "Password",
            maxlength: 72,
            class: "input w-full" %>
        </div>

        <div class="text-right">
          <%= link_to "Forgot password?", new_password_path,
            class: "link link-primary text-sm" %>
        </div>

        <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
      <% end %>

      <p class="text-center text-sm">
        New User?
        <%= link_to "Create account", new_registration_path,
          class: "link link-primary" %>
      </p>
    </div>
  </div>
</div>