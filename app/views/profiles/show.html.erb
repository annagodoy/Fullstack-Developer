<div class="space-y-4">
  <% if notice = flash[:notice] %>
    <p role="status"><%= notice %></p>
  <% end %>

  <h1 class="text-2xl font-bold">My profile</h1>

  <% if @current_user.avatar_image.attached? %>
    <%= image_tag avatar_profile_path,
      alt: "Avatar image",
      class: "h-24 w-24 rounded-full object-cover",
      width: 96,
      height: 96
    %>
  <% end %>

  <dl class="space-y-2">
    <div>
      <dt class="font-semibold">Full name</dt>
      <dd id="profile-full-name">
        <%= @current_user.full_name.presence || "Not available" %>
      </dd>
    </div>
    <div>
      <dt class="font-semibold">Email</dt>
      <dd id="profile-email"><%= @current_user.email %></dd>
    </div>
    <div>
      <dt class="font-semibold">Role</dt>
      <dd><%= @current_user.role.humanize %></dd>
    </div>
  </dl>

  <%= link_to "Edit profile", edit_profile_path, class: "underline" %>

  <%= button_to "Delete profile", profile_path,
    method: :delete, form: {
      data: {
        turbo_confirm: "Are you sure? This cant be undone."
      }
    },
    class: "rounded bg-red-700 px-4 py-2 text-white"
  %>

  <%= button_to "Sign out", session_path, method: :delete,
    class: "rounded bg-indigo-600 px-4 py-2 text-white" %>
</div>