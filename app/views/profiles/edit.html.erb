<div class="w-full max-w-lg space-y-4">
  <h1 class="text-2xl font-bold">Edit profile</h1>

  <% if @current_user.errors.any? %>
    <div role="alert" class="rounded bg-red-50 p-4 text-red-700">
      <ul>
        <% @current_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @current_user, url: profile_path,
    method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :full_name, class: "block font-semibold" %>
      <%= form.text_field :full_name,
        autocomplete: "name",
        class: "w-full rounded border p-2",
        required: true
      %>
    </div>

    <div>
      <%= form.label :email, class: "block font-semibold" %>
      <%= form.email_field :email,
        autocomplete: "email",
        class: "w-full rounded border p-2",
        required: true
      %>
    </div>

    <div>
      <%= form.label :avatar_image, class: "block font-semibold" %>
      <%= form.file_field :avatar_image,
        accept: "image/jpeg,image/png",
        aria: { describedby: "avatar-help" }
      %>

      <p id="avatar-help" class="text-sm text-gray-600">
        JPEG or PNG only, up to 5MB.
      </p>
    </div>

    <%= form.submit "Save",
      class: "rounded bg-indigo-600 px-4 py-2 text-white" %>
    <%= link_to "Cancel", profile_path, class: "underline" %>
  <% end %>
</div>