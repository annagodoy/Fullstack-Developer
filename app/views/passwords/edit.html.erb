<div class="mx-auto max-w-md py-4 sm:py-10">
  <div class="card border border-base-300 bg-base-100">
    <div class="card-body gap-6 p-5 sm:p-8">
      <div>
        <h1 class="text-2xl font-bold">Update your password</h1>
        <p class="mt-2 text-base-content/70">
          Create a new password.
        </p>
      </div>

      <% if alert = flash[:alert] %>
        <div id="alert" role="alert" class="alert alert-error">
          <span><%= alert %></span>
        </div>
      <% end %>

      <%= form_with url: password_path(params[:token]),
        method: :put, class: "space-y-5" do |form| %>
        <div class="space-y-2">
          <%= form.label :password, "New password",
            class: "block text-sm font-medium" %>

          <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            minlength: 12,
            maxlength: 72,
            aria: { describedby: "password-help" },
            class: "input w-full" %>

          <p id="password-help" class="text-sm text-base-content/70">
            Use at least 12 characters.
          </p>
        </div>

        <div class="space-y-2">
          <%= form.label :password_confirmation, "Confirm new password",
            class: "block text-sm font-medium" %>

          <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            minlength: 12,
            maxlength: 72,
            class: "input w-full" %>
        </div>

        <%= form.submit "Save", class: "btn btn-primary w-full" %>
      <% end %>

      <%= link_to "Back to sign in", new_session_path,
        class: "link link-primary text-center text-sm" %>
    </div>
  </div>
</div>