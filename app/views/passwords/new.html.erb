<div class="mx-auto max-w-md py-4 sm:py-10">
  <div class="card border border-base-300 bg-base-100">
    <div class="card-body gap-6 p-5 sm:p-8">
      <div>
        <h1 class="text-2xl font-bold">Forgot your password?</h1>
        <p class="mt-2 text-base-content/70">
          Enter your email to request password reset instructions.
        </p>
      </div>

      <% if alert = flash[:alert] %>
        <div id="alert" role="alert" class="alert alert-error">
          <span><%= alert %></span>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div id="notice" role="status" class="alert alert-success">
          <span><%= notice %></span>
        </div>
      <% end %>

      <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
        <div class="space-y-2">
          <%= form.label :email, class: "block text-sm font-medium" %>
          <%= form.email_field :email,
            required: true,
            autocomplete: "username",
            placeholder: "Email",
            value: params[:email],
            class: "input w-full" %>
        </div>

        <%= form.submit "Send",
          class: "btn btn-primary w-full" %>
      <% end %>

      <%= link_to "Back to sign in", new_session_path,
        class: "link link-primary text-center text-sm" %>
    </div>
  </div>
</div>