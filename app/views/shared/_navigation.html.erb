<header class="border-b border-base-300 bg-base-100">
  <nav aria-label="Main navigation"
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="flex min-h-16 flex-wrap items-center justify-between gap-3 py-3">
      <%= link_to "Home",
        root_path,
        class: "text-xl font-bold tracking-tight text-primary" %>

      <% if authenticated? %>
        <div class="flex min-w-0 items-center gap-3">
          <span class="hidden max-w-48 truncate text-sm sm:block">
            <%= Current.user.full_name %>
          </span>

          <span class="badge badge-soft badge-primary">
            <%= Current.user.role.humanize %>
          </span>

          <%= button_to "Sign out", session_path,
            method: :delete,
            class: "btn btn-ghost btn-sm" %>
        </div>
      <% else %>
        <div class="flex items-center gap-2">
          <%= link_to "Sign in", new_session_path,
            class: "btn btn-ghost btn-sm" %>

          <%= link_to "Create account", new_registration_path,
            class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>

    <% if authenticated? %>
      <ul class="flex flex-wrap gap-2 pb-3">
        <% if Current.user.admin? %>
          <li>
            <%= link_to "Dashboard", admin_root_path,
              class: "btn btn-ghost btn-sm",
              aria: {
              current: ("page" if current_page?(admin_root_path))
              } %>
          </li>

          <li>
            <%= link_to "Users", admin_users_path,
              class: "btn btn-ghost btn-sm",
              aria: {
                current: ("page" if current_page?(admin_users_path))
              } %>
          </li>

          <li>
            <%= link_to "Import users", new_admin_user_import_path,
              class: "btn btn-ghost btn-sm",
              aria: {
              current: ("page" if current_page?(new_admin_user_import_path))
              } %>
          </li>
        <% end %>

        <li>
          <%= link_to "My profile", profile_path,
            class: "btn btn-ghost btn-sm",
            aria: {
              current: ("page" if current_page?(profile_path))
            } %>
        </li>
      </ul>
    <% end %>
  </nav>
</header>