<div class="w-full max-w-xl">
  <h1 class="text-2xl font-bold">Import users</h1>

  <p class="my-4">
    Upload a CSV or XLSX spreadsheet up to 5 MB.
  </p>

  <% if @user_import.errors.any? %>
    <div role="alert" class="mb-4 rounded border border-red-500 p-4">
      <ul class="list-inside list-disc">
        <% @user_import.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, @user_import], class: "space-y-4" do |form| %>
    <div>
      <%= form.label :spreadsheet, class: "block font-medium" %>
      <%= form.file_field :spreadsheet,
        accept: ".csv,.xlsx",
        required: true,
        class: "mt-2 block w-full" %>
    </div>

    <%= form.submit "Upload spreadsheet",
      class: "rounded bg-blue-700 px-4 py-2 text-white" %>
  <% end %>

  <%= link_to "Back to dashboard", admin_root_path,
    class: "mt-6 inline-block underline" %>
</div>
