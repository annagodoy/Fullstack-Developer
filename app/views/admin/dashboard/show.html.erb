<%= turbo_stream_from "admin_dashboard" %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold sm:text-3xl">Admin Dashboard</h1>
      <p class="mt-2 text-base-content/70">
        Manage users and account activity.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Import users", new_admin_user_import_path,
        class: "btn btn-outline btn-primary btn-outline" %>

      <%= link_to "Create user", new_admin_user_path,
        class: "btn btn-primary" %>
    </div>
  </div>

  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="stat min-w-0 rounded-box border border-base-300 bg-base-100">
      <dt class="stat-title">Total users</dt>
      <dd id="total-users" class="stat-value text-primary">
        <%= @total_users %>
      </dd>
      <dd class="stat-desc">All registered accounts</dd>
    </div>

    <div class="stat min-w-0 rounded-box border border-base-300 bg-base-100">
      <dt class="stat-title">Admins</dt>
      <dd id="admin-users" class="stat-value">
        <%= @users_by_role.fetch("admin", 0) %>
      </dd>
    </div>

    <div class="stat min-w-0 rounded-box border border-base-300 bg-base-100">
      <dt class="stat-title">Members</dt>
      <dd id="member-users" class="stat-value">
        <%= @users_by_role.fetch("member", 0) %>
      </dd>
    </div>
  </dl>

  <section aria-labelledby="user-management-heading"
    class="card border border-base-300 bg-base-100">
    <div class="card-body">
      <h2 id="user-management-heading" class="card-title">
        User management
      </h2>

      <p class="text-base-content/70">
        View accounts, update roles and manage user profiles.
      </p>

      <div class="card-actions mt-2">
        <%= link_to "Manage users", admin_users_path,
          class: "btn btn-primary" %>
      </div>
    </div>
  </section>
</div>