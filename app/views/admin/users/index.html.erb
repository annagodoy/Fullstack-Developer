<div class="w-full space-y-4">
  <% if notice = flash[:notice] %>
    <p role="status"><%= notice %></p>
  <% end %>

  <h1 class="text-2xl font-bold">Users</h1>

  <%= link_to "New user", new_admin_user_path, class: "underline" %>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-left">
      <thead>
        <tr class="border-b">
        <th scope="col" class="p-3">Full name</th>
        <th scope="col" class="p-3">Email</th>
        <th scope="col" class="p-3">Role</th>
        <th scope="col" class="p-3">Edit</th>
        <th scope="col" class="p-3">Delete</th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr id="<%= dom_id(user) %>" class="border-b">
          <td class="p-3"><%= user.full_name %></td>
          <td class="p-3"><%= user.email %></td>
          <td class="p-3"><%= user.role.humanize %></td>

          <td class="p-3">
            <%= link_to "Edit", edit_admin_user_path(user), 
              class: "underline"
            %>
          </td>

          <td class="p-3">
            <%= button_to "Delete", admin_user_path(user), 
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "Are you sure? This cant be undone."
                }
              },
              class: "text-red-700 underline" 
            %>
          </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <nav aria-label="Users pagination" class="flex items-center gap-4">
      <% if @page > 1 %>
        <%= link_to "<<", admin_users_path(page: @page - 1),
          rel: "prev", class: "underline" %>
      <% end %>

      <span>Page <%= @page %></span>

      <% if @has_next_page %>
        <%= link_to ">>", admin_users_path(page: @page + 1),
          rel: "next", class: "underline" %>
      <% end %>
    </nav>
  </div>
</div>