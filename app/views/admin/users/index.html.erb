<div class="space-y-6">
  <% if notice = flash[:notice] %>
    <div role="status" class="alert alert-success">
      <span><%= notice %></span>
    </div>
  <% end %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold sm:text-3xl">Users</h1>
      <p class="mt-2 text-base-content/70">
        Manage accounts, roles and profiles.
      </p>
    </div>

    <%= link_to "New user", new_admin_user_path,
      class: "btn btn-primary" %>
  </div>

  <div class="overflow-hidden rounded-box border border-base-300 bg-base-100">
    <% if @users.any? %>
      <%= render partial: "users_list"%>
    <% else %>
      <div class="p-8 text-center">
        <h2 class="text-lg font-semibold">No users on this page</h2>
        <p class="mt-2 text-base-content/70">
          Return to the first page to see available accounts.
        </p>

        <%= link_to "First page", admin_users_path,
          class: "btn btn-primary mt-4" %>
      </div>
    <% end %>

    <nav aria-label="Users pagination"
      class="flex flex-wrap items-center justify-between gap-3 border-t border-base-300 p-4">
      <span class="text-sm text-base-content/70">
        Page <%= @page %>
      </span>

      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous", admin_users_path(page: @page - 1),
            rel: "prev", class: "btn btn-outline btn-sm" %>
        <% end %>

        <% if @has_next_page %>
          <%= link_to "Next", admin_users_path(page: @page + 1),
            rel: "next", class: "btn btn-outline btn-sm" %>
        <% end %>
      </div>
    </nav>
  </div>
</div>