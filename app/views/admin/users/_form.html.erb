<% if @user.errors.any? %>
  <div role="alert" class="alert alert-error mb-4">
    <ul class="list-inside list-disc">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @user], class: "space-y-6" do |form| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="min-w-0 space-y-2">
      <%= form.label :full_name, class: "block text-sm font-medium" %>
      <%= form.text_field :full_name,
        required: true,
        autocomplete: "name",
        class: "input w-full" %>
    </div>

    <div class="min-w-0 space-y-2">
      <%= form.label :email, class: "block text-sm font-medium" %>
      <%= form.email_field :email,
        required: true,
        autocomplete: "email",
        class: "input w-full" %>
    </div>

    <div class="min-w-0 space-y-2">
      <%= form.label :role, class: "block text-sm font-medium" %>
      <%= form.select :role,
        User.roles.keys.map { |role| [role.humanize, role] },
        {},
        class: "select w-full",
        aria: { describedby: "role-help" } %>

      <p id="role-help" class="text-sm text-base-content/70">
        Admins can manage all users and import spreadsheets.
      </p>
    </div>

    <% if @user.new_record? %>
      <div class="min-w-0 space-y-2">
        <%= form.label :password, "Initial password",
          class: "block text-sm font-medium" %>

        <%= form.password_field :password,
          required: true,
          minlength: 12,
          autocomplete: "new-password",
          aria: { describedby: "password-help" },
          class: "input w-full" %>

        <p id="password-help" class="text-sm text-base-content/70">
          Use at least 12 characters.
        </p>
      </div>
    <% end %>
  </div>

  <div class="space-y-2">
    <%= form.label :avatar_image, "Avatar",
      class: "block text-sm font-medium" %>

    <%= form.file_field :avatar_image,
      accept: "image/jpeg,image/png",
      aria: { describedby: "avatar-help" },
      class: "file-input w-full" %>

    <p id="avatar-help" class="text-sm text-base-content/70">
      JPEG or PNG, up to 5 MB. Upload a new image to replace the current avatar.
    </p>
  </div>

  <div class="flex flex-col gap-2 border-t border-base-300 pt-5 sm:flex-row">
    <%= form.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn-ghost" %>
  </div>
<% end %>

<% if @user.persisted? && @user.avatar_image.attachment&.persisted? %>
  <section aria-labelledby="current-avatar-heading"
    class="mt-6 border-t border-base-300 pt-6">
    <h2 id="current-avatar-heading" class="font-semibold">Current avatar</h2>

    <div class="mt-4 flex flex-wrap items-center gap-4">
      <div class="avatar">
        <div class="w-24 rounded-full">
          <%= image_tag avatar_admin_user_path(@user),
            alt: "Current avatar",
            width: 96,
            height: 96 %>
        </div>
      </div>

      <%= button_to "Remove avatar",
        avatar_admin_user_path(@user),
        method: :delete,
        form: {
          data: { turbo_confirm: "Remove this user's avatar?" }
        },
        class: "btn btn-outline btn-error btn-sm" %>
    </div>
  </section>
<% end %>