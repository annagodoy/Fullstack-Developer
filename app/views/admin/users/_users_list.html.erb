<div class="overflow-x-auto" role="region" aria-label="User accounts" tabindex="0">
  <table class="table w-full">
    <caption class="sr-only">
      User accounts and administrative actions
    </caption>

    <thead>
      <tr>
        <th scope="col">Full name</th>
        <th scope="col">Email</th>
        <th scope="col">Role</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td class="min-w-40 max-w-64 break-words font-medium">
            <%= user.full_name %>
          </td>

          <td class="min-w-48 max-w-80 break-all">
            <%= user.email %>
          </td>

          <td>
            <span class="badge <%= user.admin? ? 'badge-primary' : 'badge-ghost' %>">
              <%= user.role.humanize %>
            </span>
          </td>

          <td>
            <div class="flex items-center gap-2">
              <%= link_to "Edit", edit_admin_user_path(user),
                class: "btn btn-ghost btn-sm" %>

              <%= button_to "Delete", admin_user_path(user),
                method: :delete,
                form: {
                  data: {
                    turbo_confirm: "Delete #{user.full_name}? This cannot be undone."
                  }
                },
                class: "btn btn-outline btn-error btn-sm" %>
            </div>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>
</div>